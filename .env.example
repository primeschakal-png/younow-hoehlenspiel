# Kopieren nach .env und anpassen (start.bat macht das beim ersten Start automatisch)

# Webserver
HOST=127.0.0.1
PORT=8000

# Spiel
VOTE_SECONDS=28
STEP_SECONDS=0.25
IDLE_MINUTES=5

# LLM (OpenAI-kompatibel), wird ab Etappe 5 genutzt
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=local

# llama-server (start.bat startet ihn nur bei LLAMA_START=1)
LLAMA_START=0
LLAMA_PORT=8080
LLAMA_SERVER_EXE=C:\llama\llama-server.exe
LLAMA_MODEL_PATH=C:\llama\models\modell.gguf
