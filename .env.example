# Vorgaben. Bitte hier nichts ändern: eigene Werte setzt die Einstellungsseite
# (http://localhost:8000/einstellungen) in .env. Dort steht nur, was von hier abweicht.

# Webserver (wirkt nach Neustart)
HOST=127.0.0.1
PORT=8000

# Ablauf
VOTE_SECONDS=28
STEP_SECONDS=0.25
SAY_COOLDOWN=30

# Lager und Leerlauf
IDLE_MINUTES=5
IDLE_VOTE_SECONDS=8
CAMP_MAX_MINUTES=8
CAMP_PAUSE_MINUTES=10

# Überleben und Balance
BAL_THIRST_PER_TILE=0.067
BAL_HUNGER_PER_TILE=0.03
BAL_CAMP_NEED_FACTOR=0.03
BAL_FOOD_VALUE=45
BAL_COOKED_FOOD_VALUE=65
BAL_WATER_VALUE=50
BAL_POTION_HEAL=8
BAL_HERO_BONUS=2
BAL_EVENT_PAUSE=3
BAL_DEATH_PAUSE=8

# Karte
MAP_CELLS_W=16
MAP_CELLS_H=10
REVEAL_RADIUS=4

# YouNow (Chat und Geschenke über die öffentliche Stream-Info)
YOUNOW_ENABLED=0
YOUNOW_USER=
YOUNOW_POLL_SECONDS=3
CHAT_OVERLAY=0
BRIBE_LIKES_PER_VOTE=1000

# Ton
SOUND_ENABLED=1
MUSIC_VOLUME=35
SFX_VOLUME=70

# LLM (OpenAI-kompatibel)
LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=local
LLM_TIMEOUT=25

# llama-server, wird von start.bat gestartet (LLAMA_START=1), laeuft er schon, wird er mitgenutzt
LLAMA_START=1
LLAMA_PORT=8080
LLAMA_SERVER_EXE=C:\llama-cuda\llama-server.exe
LLAMA_MODEL_PATH=E:\KI-Modelle\Qwen3.6-27B-UD-Q3_K_XL.gguf
LLAMA_CTX=8192
LLAMA_NGL=99
LLAMA_EXTRA=-fa on -np 1 --spec-type draft-mtp --spec-draft-n-max 2
