# Kopieren nach .env und anpassen

# Webserver
HOST=127.0.0.1
PORT=8000

# LLM (OpenAI-kompatibel)
# Lokal: llama-server
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=local

# Pfad zu llama-server und Modell (für start.bat)
LLAMA_SERVER_EXE=C:\llama\llama-server.exe
LLAMA_MODEL_PATH=C:\llama\models\modell.gguf

# Spiel
VOTE_SECONDS=28
IDLE_MINUTES=5
