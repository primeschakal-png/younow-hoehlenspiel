# Vorgaben. Eigene Werte in .env eintragen (start.bat legt sie beim ersten Start an).
# Fehlt ein Wert in .env, gilt der Wert von hier.

# Webserver
HOST=127.0.0.1
PORT=8000

# Spiel
VOTE_SECONDS=28
STEP_SECONDS=0.25
IDLE_MINUTES=5
IDLE_VOTE_SECONDS=10

# LLM (OpenAI-kompatibel)
LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=local
LLM_TIMEOUT=25

# llama-server, wird von start.bat gestartet (LLAMA_START=1), laeuft er schon, wird er mitgenutzt
LLAMA_START=1
LLAMA_PORT=8080
LLAMA_SERVER_EXE=C:\llama-cuda\llama-server.exe
LLAMA_MODEL_PATH=E:\KI-Modelle\Qwen3.6-27B-UD-Q3_K_XL.gguf
LLAMA_CTX=8192
LLAMA_NGL=99
LLAMA_EXTRA=-fa on -np 1 --spec-type draft-mtp --spec-draft-n-max 2
