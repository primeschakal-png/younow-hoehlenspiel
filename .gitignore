# Schlüssel und lokale Einstellungen
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Spielstand und Logs
save/
logs/
*.log

# Betriebssystem
.DS_Store
Thumbs.db

# Erzeugte Listen zum Vertonen
assets/narrator/vertonung*
assets/narrator/funfacts.epub
assets/narrator/funfacts.txt

# Eigene Musik (z. B. StreamBeats) bleibt lokal: deren Lizenz verbietet die Weitergabe der Dateien.
# Bereits eingecheckte CC0-Titel sind davon nicht betroffen.
assets/audio/music/**/*.mp3
assets/audio/music/**/*.ogg
assets/audio/music/**/*.wav
assets/audio/music/**/*.flac
assets/audio/music/**/*.m4a
